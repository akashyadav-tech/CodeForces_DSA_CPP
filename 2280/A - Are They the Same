#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin >> t;
 
    while (t--) {
        int n, k;
        cin >> n >> k;
 
        vector<int> a(n), b(n);
 
        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
 
        for (int i = 0; i < n; i++) {
            cin >> b[i];
        }
 
        int x = 0, y = 0;
 
        for (int i = 0; i < n; i++) {
            if (a[i] % 2 != k % 2) {
                x++;
            }
 
            if (b[i] % 2 != k % 2) {
                y++;
            }
        }
 
        if (x >= y) {
            cout << "YES
";
        } 
        else {
            cout << "NO
";
        }
    }
 
    return 0;
}